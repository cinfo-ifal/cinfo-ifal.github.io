---
import { publicados } from "../../../servicos/publicacoes";
import Container from "../../../components/container.astro";
import LayoutPage from "../../../layouts/layout-page.astro";
import { dataIso, dataParaLocalString } from "../../../servicos/utils";
import calendario from "../../../assets/calendario.svg?raw";

const tccs = await publicados("tccs");
---

<LayoutPage title="TCCs">
    <Container>
        <section class="max-w-3xl mb-8 p-6 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg">
            <h2 class="text-gray-800 dark:text-gray-200 text-xl font-medium mb-3">
                TCCs no REDIFAL
            </h2>
            <p class="text-gray-700 dark:text-gray-300">
                Os Trabalhos de Conclusão de Curso do Ifal são publicados no
                REDIFAL, o Repositório Institucional Digital do Instituto
                Federal de Alagoas, que reúne em acesso aberto a produção
                técnica, científica e cultural da instituição. No repositório,
                é possível pesquisar os trabalhos por título, autor ou curso.
            </p>
            <a
                class="mt-4 inline-block text-blue-600 dark:text-blue-400 hover:underline"
                href="https://repositorio.ifal.edu.br/home"
                target="_blank"
                rel="noopener"
                title="Ir para o REDIFAL, Repositório Institucional Digital do Ifal"
            >
                Acessar o REDIFAL
            </a>
        </section>
        <ul>
            {
                tccs.map((tcc) => (
                    <li>
                        <a
                            class="w-full max-w-md p-6 bg-white dark:bg-gray-800 hover:bg-gray-100 dark:hover:bg-gray-700 border border-gray-200 dark:border-gray-700 rounded-lg block"
                            href={`/projetos/tccs/${tcc.slug}`}
                            title={"Saiba mais sobre o tcc: " + tcc.data.titulo}
                        >
                            <h2 class="text-gray-800 text-lg font-medium dark:text-gray-200 line-clamp-3">
                                {tcc.data.titulo}
                            </h2>
                            <small class="my-3 flex gap-2 items-center text-gray-600 dark:text-gray-400">
                                <Fragment set:html={calendario} />
                                <time datetime={dataIso(tcc.data.publicadoEm, false)}>
                                    {dataParaLocalString(tcc.data.publicadoEm, false)}
                                </time>
                            </small>
                            <div class="mt-5 flex gap-2 flex-wrap">
                                {tcc.data.palavrasChave?.map(
                                    (palavraChave: string, index: number) =>
                                        index < 8 && (
                                            <span class="bg-gray-200 dark:bg-gray-600 text-gray-800 dark:text-gray-200 text-sm px-2 py-1 rounded-full">
                                                {palavraChave}
                                            </span>
                                        )
                                )}
                            </div>
                        </a>
                    </li>
                ))
            }
        </ul>
    </Container>
</LayoutPage>
