---
import { getCollection } from "astro:content";
import LayoutPage from "../../../layouts/layout-page.astro";
import Container from "../../../components/container.astro";
import { dataParaLocalString } from "../../../servicos/utils";
import calendario from "../../../assets/calendario.svg?raw";
import atualizar from "../../../assets/atualizar.svg?raw";

export async function getStaticPaths() {
    const guias = await getCollection("guias");
    return (
        guias.map((guia) => ({
            params: {
                slug: guia.slug,
            },
            props: {
                guia: guia,
            },
        })) || []
    );
}

const BASE_URL = import.meta.env.BASE_URL;

const { guia } = Astro.props;
const { Content } = await guia.render();
---

<LayoutPage title={guia.data.titulo}>
    <Container>
        <div class="mb-6">
            <img
                src={`${BASE_URL}images/guias/${guia.data.foto}`}
                alt=""
                class="w-full max-w-3xl aspect-video mx-auto rounded-lg object-cover"
            />
        </div>
        <div
            class="mb-6 p-4 text-gray-800 dark:text-gray-300 border-y border-gray-300 dark:border-gray-700"
        >
            <p class="mb-1 flex gap-2 justify-center">
                <time datetime={guia.data.publicadoEm} class="flex gap-2 items-center">
                    <Fragment set:html={calendario} />
                    {dataParaLocalString(guia.data.publicadoEm)}
                </time>

                {
                    guia.data.modificadoEm && (
                        <time datetime={guia.data.modificadoEm} class="flex gap-2 items-center">
                            {"-"}
                            <Fragment set:html={atualizar} />
                            {dataParaLocalString(guia.data.modificadoEm)}
                        </time>
                    )
                }
            </p>
            <p class="mb-3 text-center">
                Escrita por <strong>{guia.data.autoria}</strong>
            </p>
            {
                guia.data.tags.length > 0 && (
                    <div class="mt-3 flex gap-2 justify-center">
                        {guia.data.tags.map((tag: string) => (
                            <span class="inline-block px-2 py-1 text-sm bg-gray-200 dark:bg-gray-700 text-gray-800 dark:text-gray-300 rounded-full">
                                #{tag}
                            </span>
                        ))}
                    </div>
                )
            }
        </div>
        <div class="w-full max-w-3xl mx-auto">
            <article class="max-w-none w-full py-10 prose dark:prose-invert">
                <Content />
            </article>
        </div>
    </Container>
</LayoutPage>
