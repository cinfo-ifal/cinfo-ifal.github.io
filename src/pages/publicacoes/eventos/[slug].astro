---
import { getCollection } from "astro:content";
import LayoutPage from "../../../layouts/layout-page.astro";
import Container from "../../../components/container.astro";
import { dataParaLocalString } from "../../../servicos/utils";
import calendario from "../../../assets/calendario.svg?raw";

export async function getStaticPaths() {
    const eventos = await getCollection("eventos");
    return (
        eventos.map((evento) => ({
            params: {
                slug: evento.slug,
            },
            props: {
                evento,
            },
        })) || []
    );
}

const { evento } = Astro.props;
const { Content } = await evento.render();
---

<LayoutPage title={evento.data.titulo}>
    <Container>
        <div class="mb-6">
            <img
                src={`/images/eventos/${evento.data.foto}`}
                alt=""
                class="w-full max-w-3xl aspect-video mx-auto rounded-lg object-cover"
            />
        </div>

        <div
            class="mb-6 p-4 text-gray-800 dark:text-gray-300 border-y border-gray-300 dark:border-gray-700"
        >
            <p class="mb-3 flex gap-2 justify-center">
                <time datetime={evento.data.dataInicio} class="flex gap-2 items-center">
                    <Fragment set:html={calendario} />
                    {dataParaLocalString(evento.data.dataInicio)}
                </time> -
                {
                    evento.data.dataFim && (
                        <time datetime={evento.data.dataFim}>
                            {dataParaLocalString(evento.data.dataFim)}
                        </time>
                    )
                }
            </p>
            <p class="flex gap-2 justify-center">
                <svg
                    viewBox="0 0 64 64"
                    xmlns="http://www.w3.org/2000/svg"
                    stroke-width="3"
                    class="stroke-current"
                    fill="none"
                    width="18"
                    ><path
                        d="M31.56,56.51S14.41,37.67,14.41,25.39c0-14.49,9.48-17.84,17.15-17.84,7.06,0,16.13,3.79,16.13,17.84C47.69,38.07,31.56,56.51,31.56,56.51Z"
                    ></path>
                    <circle cx="31.05" cy="22.24" r="6.93"></circle>
                </svg>
                <span>{evento.data.local}</span>
            </p>
            {
                evento.data.tags.length > 0 &&
                <div class="mt-3 flex gap-2 justify-center">
                    {
                        evento.data.tags.map((tag: string) => (
                            <span class="inline-block px-2 py-1 text-sm bg-gray-200 dark:bg-gray-700 text-gray-800 dark:text-gray-300 rounded-full">
                                #{tag}
                            </span>
                        ))
                    }
                </div>
            }
        </div>

        <div class="w-full max-w-3xl mx-auto">
            <article class="w-full max-w-none prose dark:prose-invert">
                <Content />
            </article>
        </div>
    </Container>
</LayoutPage>
