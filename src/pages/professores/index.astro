---
import Container from "../../components/container.astro";
import LayoutPage from "../../layouts/layout-page.astro";
import CartaoProfessor from "../../components/cartao-professor.astro";

import { getCollection } from "astro:content";

const professores = await getCollection("professores", ({ data }) => data.ativo);

---

<LayoutPage title="Professores">
    <Container>
        <ul class="py-10 grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 justify-items-center gap-5">
            {
                professores.map((professor) => (
                    <CartaoProfessor 
                        href={`professores/${professor.slug}`}
                        nome={professor.data.nome}
                        email={professor.data.email}
                        sitePessoal={professor.data.sitePessoal}
                        curriculoLattes={professor.data.curriculoLattes}
                        foto={professor.data.foto}
                    />
                ))
            }
        </ul>
    </Container>
</LayoutPage>
