---
import Container from "../components/container.astro";
import LayoutPrincipal from "./layout-principal.astro";
import home from "../assets/home.svg?raw";
import indicador from "../assets/indicador-para-direita.svg?raw";

interface Props {
    title: string;
}



const { href } = Astro.url;
const { title } = Astro.props;

const urlParts = new URL(href).pathname.split("/").filter(Boolean);

const generateCumulativePath = (parts: string[], index: number) => {
    return "/" + parts.slice(0, index + 1).join("/");
};
---

<LayoutPrincipal title={"CINFO | " + title}>
    <div class="py-4 bg-white dark:bg-gray-800 border-b border-gray-200 dark:border-gray-700">
        <Container>
            <nav class="w-full flex" aria-label="Breadcrumb">
                <ol
                    class="w-full overflow-hidden inline-flex items-center space-x-1 md:space-x-2 rtl:space-x-reverse"
                >
                    <li class="flex-shrink-0 inline-flex items-center truncate">
                        <a
                            href="/"
                            class="inline-flex items-center text-sm font-medium text-gray-700 hover:text-blue-600 dark:text-gray-400 dark:hover:text-white"
                            title="Ir para a página inicial"
                        >
                            <Fragment set:html={home} aria-hidden="true" />
                            <span class="ml-2">
                                Home
                            </span>
                        </a>
                    </li>

                    {
                        urlParts.map((part, index) => {
                            if (part === "cinfo-astro") return null;
                            return (
                                <li class="flex-shrink-0 truncate">
                                    <div class="flex items-center">
                                        <p class="text-gray-500 dark:text-gray-400"><Fragment set:html={indicador} aria-hidden="true"/></p>
                                        {index === urlParts.length - 1 ? (
                                            <span class="max-w-xs ms-1 text-sm font-medium text-gray-500 md:ms-2 dark:text-gray-400 text-nowrap truncate">
                                                {title}
                                            </span>
                                        ) : (
                                            <a
                                                href={generateCumulativePath(urlParts, index)}
                                                class="ms-1 text-sm font-medium text-gray-700 hover:text-blue-600 md:ms-2 dark:text-gray-400 dark:hover:text-white"
                                                title={`Ir para a página ${part}`}
                                            >
                                                {part.charAt(0).toUpperCase() + part.slice(1)}
                                            </a>
                                        )}
                                    </div>
                                </li>
                            );
                        })
                    }
                </ol>
            </nav>
            <h1 class="mt-4 text-3xl font-bold text-gray-800 dark:text-gray-100">
                {title}
            </h1>
        </Container>
    </div>
    <div class="min-h-[calc(100vh-200px)] py-10">
        <slot />
    </div>
</LayoutPrincipal>
