---
interface Props {
    slug: string;
    titulo: string;
    descricao: string;
    foto: string;
}

const { slug, titulo, descricao, foto } = Astro.props;
---

<a
    href={`publicacoes/noticias/${slug}`}
    title={`Ler a noticia: ${titulo}`}
    class="w-full h-full p-1 flex items-center border rounded-lg shadow border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 hover:bg-gray-100 dark:hover:bg-gray-700"
>
    <img
        class="w-full h-full max-w-[35%] sm:max-w-[50%] border shadow-sm rounded object-cover sm:w-48"
        src={`/images/noticias/${foto}`}
        alt=""
    />
    <div class="px-4 leading-normal flex flex-col justify-between">
        <h3 class="mb-2 text-lg font-bold tracking-tight text-gray-800 dark:text-white line-clamp-2">
            {titulo}
        </h3>
        <p class="mb-3 text-sm font-normal text-gray-600 dark:text-gray-300 line-clamp-3">
            {descricao}
        </p>
    </div>
</a>
