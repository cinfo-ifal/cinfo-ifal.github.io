---
interface Props {
    href: string;
    conteudo: string;
    target?: string;
    titulo?: string;
}

const { href, conteudo, target, titulo } = Astro.props;
---

<a
    href={href}
    class="text-blue-600 dark:text-blue-400 hover:underline"
    title={titulo}
    target={target}
>
    {conteudo}
</a>
