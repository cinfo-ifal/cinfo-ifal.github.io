---
import BotaoLink from "./botao-link.astro";
import setaParaDireita from "../assets/seta-para-direita.svg?raw";

interface Props {
  slug: string;
  titulo: string;
  descricao: string;
  foto: string;
}

const { slug, titulo, descricao, foto } = Astro.props;
---

<div
  class="w-full max-h-full p-1 bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg shadow md:row-span-3 flex flex-col relative"
>
  <img
    class="w-full object-cover rounded-t-lg"
    src={`/images/noticias/${foto}`}
    alt=""
  />
  <div class="h-full p-5 flex flex-col relative">
    <div class="">
      <h3
        class="mb-2 text-2xl font-bold text-gray-800 dark:text-white tracking-tight line-clamp-2"
      >
        {titulo}
      </h3>
      <p class="mb-3 font-normal text-gray-600 dark:text-gray-400 line-clamp-3">
        {descricao}
      </p>
    </div>
    <BotaoLink
      href={`/publicacoes/noticias/${slug}`}
      titulo={`Ler a noticia: ${titulo}`}
    >
      Leia mais
      <Fragment set:html={setaParaDireita} aria-hidden="true" />
    </BotaoLink>
  </div>
</div>
