---
interface Props {
    titulo: string;
    href?: string;
}

const { titulo, href } = Astro.props;
---

<Fragment>
    {
        href && (
            <li>
                <a
                    href={href}
                    target="_blank"
                    title={titulo}
                    class="mt-2 p-2 text-blue-600 dark:text-blue-400 text-xl block hover:bg-gray-300 dark:hover:bg-gray-700  rounded"
                >
                    <slot />
                </a>
            </li>
        )
    }
</Fragment>
