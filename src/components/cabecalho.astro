---
import { getCollection } from "astro:content";

import Container from "./container.astro";
import SubmenuNav from "./submenu-nav.astro";

import menu from "../assets/menu.svg?raw";
import LinkNavbar from "./link-navbar.astro";
import LinkSubmenu from "./link-submenu.astro";

const BASE_URL = import.meta.env.BASE_URL;

const cursos = await getCollection("cursos");
---

<header
    class="bg-white dark:bg-gray-900 sticky w-full z-20 top-0 start-0 border-b border-gray-200 dark:border-gray-700"
>
    <Container>
        <nav>
            <div class="max-w-screen-xl flex flex-wrap items-center justify-between mx-auto py-2">
                <a
                    href={BASE_URL}
                    class="flex items-center space-x-3 rtl:space-x-reverse"
                    title="Ir para a página inicial"
                >
                    <img
                        src={`${BASE_URL}images/cinfo-logo.png`}
                        class="h-12"
                        alt="logo da cinfo"
                        aria-hidden="true"
                    />
                    <span class="w-0 h-0 absolute overflow-hidden whitespace-nowrap">
                        Página inicial
                    </span>
                </a>
                <div class="flex space-x-3 md:space-x-0 rtl:space-x-reverse">
                    <button
                        data-collapse-toggle="barra-navegacao"
                        type="button"
                        class="inline-flex items-center p-2 w-10 h-10 justify-center text-sm text-gray-500 rounded-lg md:hidden hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-gray-200 dark:text-gray-400 dark:hover:bg-gray-700 dark:focus:ring-gray-600"
                        aria-controls="barra-navegacao"
                        aria-expanded="false"
                        id="botao-menu"
                    >
                        <span class="sr-only pointer-events-none">Abrir menu principal</span>
                        <Fragment
                            set:html={menu}
                            aria-hidden="true"
                            class="w-3 h-3 pointer-events-none"
                        />
                    </button>
                </div>
                <div
                    class="pb-2 md:pb-0 items-center justify-between hidden w-full md:flex md:w-auto md:order-1"
                    id="barra-navegacao"
                >
                    <ul
                        class="flex flex-col p-4 md:p-0 mt-4 font-medium border border-gray-100 rounded-lg bg-gray-50 md:space-x-8 rtl:space-x-reverse md:flex-row md:mt-0 md:border-0 md:bg-white dark:bg-gray-800 md:dark:bg-gray-900 dark:border-gray-700"
                    >
                        <LinkNavbar
                            href={`${BASE_URL}informacoes`}
                            title="Ir para a página de informações"
                        >
                            Informações
                        </LinkNavbar>
                        <LinkNavbar
                            href={`${BASE_URL}professores`}
                            title="Ir para a página de professores"
                        >
                            Professores
                        </LinkNavbar>
                        <SubmenuNav id="cursos" texto_botao="Cursos" e_submenu={false}>
                            {
                                cursos.map((curso) => (
                                    <LinkSubmenu
                                        href={`${BASE_URL}cursos/${curso.slug}`}
                                        title={`Ir para a página do curso: ${curso.data.titulo}`}
                                    >
                                        {curso.data.titulo}
                                    </LinkSubmenu>
                                ))
                            }
                        </SubmenuNav>
                        <SubmenuNav id="publicacoes" texto_botao="Publicações" e_submenu={false}>
                            <LinkSubmenu
                                href={`${BASE_URL}publicacoes/noticias`}
                                title="Ir para a página de notícias"
                            >
                                Notícias
                            </LinkSubmenu>
                            <LinkSubmenu
                                href={`${BASE_URL}publicacoes/eventos`}
                                title="Ir para a página de eventos"
                            >
                                Eventos
                            </LinkSubmenu>
                            <LinkSubmenu
                                href={`${BASE_URL}publicacoes/guias`}
                                title="Ir para a página de eventos"
                            >
                                Guias
                            </LinkSubmenu>
                        </SubmenuNav>
                        <SubmenuNav id="projetos" texto_botao="Projetos" e_submenu={false}>
                            <LinkSubmenu
                                href={`${BASE_URL}projetos/projetos-ensino`}
                                title="Ir para a página de projetos de Ensino"
                            >
                                Projetos de Ensino
                            </LinkSubmenu>
                            <LinkSubmenu
                                href={`${BASE_URL}projetos/projetos-pesquisa`}
                                title="Ir para a página de projetos de Pesquisa Aplicada"
                            >
                                Projetos de Pesquisa Aplicada
                            </LinkSubmenu>
                            <LinkSubmenu
                                href={`${BASE_URL}projetos/projetos-extensao`}
                                title="Ir para a página de projetos de Extensão"
                            >
                                Projetos de Extensão
                            </LinkSubmenu>
                            <LinkSubmenu
                                href={`${BASE_URL}projetos/tccs`}
                                title="Ir para a página de TCCs"
                            >
                                TCCs
                            </LinkSubmenu>
                        </SubmenuNav>
                    </ul>
                </div>
            </div>
        </nav>
    </Container>
</header>

<script>
    const BOTAO_MENU = document.getElementById("botao-menu")!;
    const BARRA_NAVEGACAO = document.getElementById("barra-navegacao")!;

    function abrir_fechar_menu(aberto: boolean) {
        const aberto_string = aberto ? "true" : "false";
        BOTAO_MENU.setAttribute("aria-expanded", aberto_string);
        BARRA_NAVEGACAO.setAttribute("aria-expanded", aberto_string);
        BARRA_NAVEGACAO.classList.toggle("hidden");
    }

    function lidar_evento_click_botao_menu() {
        const aberto = BOTAO_MENU.getAttribute("aria-expanded") === "true";
        abrir_fechar_menu(!aberto);
    }

    BOTAO_MENU.addEventListener("click", lidar_evento_click_botao_menu);

    window.addEventListener("click", function (event) {
        console.log(event.target);
        const igual_botao_menu = event.target === BOTAO_MENU;
        const igual_barra_navegacao_ou_fillho = BARRA_NAVEGACAO.contains(event.target as Node);
        if (!igual_botao_menu && !igual_barra_navegacao_ou_fillho)
            BARRA_NAVEGACAO.classList.add("hidden");
    });
</script>
