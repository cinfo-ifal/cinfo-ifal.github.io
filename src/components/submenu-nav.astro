---
interface Props {
    id: string;
    texto_botao: string;
    e_submenu: boolean;
}

const { id, texto_botao, e_submenu } = Astro.props;
const classe_item = e_submenu ? "w-full px-4 py-2 md:hover:bg-gray-100 md:dark:hover:bg-gray-600 dark:hover:text-white": "";
const classe_submenu = e_submenu ? "shadow-none md:mt-0 md:top-0 md:right-0 md:translate-x-[calc(100%+4px)]": "";
---

<submenu-nav id={id}>
    <li class={"relative " + classe_item}>
        <button
            id={"botao" + id}
            data-dropdown-toggle={"submenu" + id}
            class="flex items-center justify-between w-full py-2 px-3 text-gray-900 rounded hover:bg-gray-100 md:hover:bg-transparent md:border-0 md:hover:text-blue-700 md:p-0 dark:text-white md:dark:hover:text-blue-500 dark:focus:text-white dark:border-gray-700 dark:hover:bg-gray-700 md:dark:hover:bg-transparent"
        >
            {texto_botao}
            <svg
                class="w-2.5 h-2.5 ms-2.5"
                aria-hidden="true"
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 10 6"
                aria-hidden="true"
            >
                <path
                    stroke="currentColor"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    aria-hidden="true"
                    d="m1 1 4 4 4-4"></path>
            </svg>
        </button>

        <div
            id={"submenu" + id}
            class={"md:w-44 z-10 md:absolute mt-3 hidden font-normal bg-white divide-y divide-gray-100 rounded md:rounded-lg md:shadow dark:bg-gray-700 dark:divide-gray-600" + classe_submenu}
        >
            <ul
                class="md:py-2 text-sm text-gray-700 dark:text-gray-400"
                aria-labelledby={"botao-" + id}
            >
                <slot />
            </ul>
        </div>
    </li>
</submenu-nav>

<script>
    class SubmenuNav extends HTMLElement {
        connectedCallback() {
            const id = this.id!;

            const BOTAO_SUBMENU = document.getElementById("botao" + id)!;
            const SUBMENU = document.getElementById("submenu" + id)!;

            const lidar_evento_clique_submenu = () => SUBMENU.classList.toggle("hidden");
            BOTAO_SUBMENU.addEventListener("click", lidar_evento_clique_submenu);


            function lidar_evento_click_fora_submenu(evento: MouseEvent) {
                const igual_botao_submenu = BOTAO_SUBMENU.contains(evento.target as Node);
                const igual_submenu = SUBMENU.contains(evento.target as Node);
            
                if (!igual_botao_submenu && !igual_submenu) {
                    SUBMENU.classList.add("hidden");
                }
            }

            window.addEventListener("click", lidar_evento_click_fora_submenu);
        }
    }

    customElements.define("submenu-nav", SubmenuNav);
</script>
