---
interface Props {
    slug: string;
    titulo: string;
    descricao: string;
}

const { slug, titulo, descricao } = Astro.props;
---

<a
    href={`/publicacoes/guias/${slug}`}
    class="block max-w-sm p-6 bg-white border border-gray-200 rounded-lg shadow hover:bg-gray-100 dark:bg-gray-800 dark:border-gray-700 dark:hover:bg-gray-700"
>
    <h5 class="mb-2 text-2xl font-bold tracking-tight text-gray-900 dark:text-white line-clamp-3">
        {titulo}
    </h5>
    <p class="font-normal text-gray-700 dark:text-gray-400 line-clamp-3">
        {descricao}
    </p>
</a>
